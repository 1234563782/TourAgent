# 配置示例；应用自动读取项目根目录 .env，不读取本示例文件。
# 系统环境变量优先，TRAVEL_LOAD_DOTENV=0 可禁用文件加载。
# 请通过私密方式注入密钥，切勿提交真实值。
TRAVEL_LLM_API_KEY=
TRAVEL_LLM_MODEL=
TRAVEL_LLM_BASE_URL=
# suffix: 固定规则在前，每次调用追加当天日期；prefix: 原始提示词内嵌日期，供对照实验。
TRAVEL_PROMPT_DATE_MODE=suffix
TRAVEL_DEFAULT_MAINLAND_BUSINESS_TRIP=1
# Default hotel queries to one room, one adult and no children when party is unspecified.
TRAVEL_DEFAULT_SINGLE_GUEST=1
JEV_ENABLED=1
JEV_MODE=primary
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_ENDPOINT=/v1/systemone
JEV_TIMEOUT_SECONDS=15
# Direct routing requires every intent to be >= threshold or <= 1-threshold.
# Probabilities between these bounds use the existing TurnRoute model.
JEV_INTENT_THRESHOLD=0.8
# 可选 JSON 对象；留空时官方 DeepSeek 使用非思考模式以兼容强制工具调用。
# 自建网关按其协议显式配置，例如 {"thinking":{"type":"disabled"}}。
TRAVEL_LLM_EXTRA_BODY=
# 模型输入预算默认开启。窗口是部署上限，需按供应商模型核实；不是自动发现的模型规格。
# 当前采用保守 UTF-8 字节估算，不冒充供应商精确 token 计数。
TRAVEL_CONTEXT_WINDOW_TOKENS=65536
TRAVEL_CONTEXT_OUTPUT_TOKENS=8192
TRAVEL_CONTEXT_MARGIN_TOKENS=4096
# 历史导航等输入组装预留，与供应商安全余量不同；0表示不额外预留，最终门禁仍生效
TRAVEL_CONTEXT_FRAME_TOKENS=1024
TRAVEL_CONTEXT_RECENT_TOKENS=12000
TRAVEL_CONTEXT_SUMMARY_TOKENS=2048
TRAVEL_CONTEXT_TOOL_TOKENS=2048
TRAVEL_CONTEXT_READ_TOKENS=6000
# 可选角色输入预算 JSON；只能缩小全局输入上限。角色包括 supervisor/slots/reviewer/planner/policy/policy_reviewer。
TRAVEL_CONTEXT_ROLE_INPUT_TOKENS={}
TRAVEL_SLOT_MAX_ATTEMPTS=3
# 槽位提取与独立复核共用的近期消息窗口；只含当前用户会话。
TRAVEL_SLOT_CONTEXT_LIMIT=16
# 单轮事项上限；需与 TRAVEL_MAX_STEPS 配合增加。
TRAVEL_SLOT_TASK_LIMIT=4
TRAVEL_PLANNER_MAX_ATTEMPTS=2
# compact: remove redundant candidate input fields; full: original input for A/B tests.
# Full candidates remain available for validation and display in both modes.
TRAVEL_PLANNER_CANDIDATE_MODE=compact
# parallel: independent transport/hotel queries run concurrently; serial: baseline for A/B tests.
TRAVEL_PLANNER_QUERY_MODE=parallel
# 可选 Langfuse 观测，只有显式设为1才启用。只上报白名单元数据，不上传正文。
# 地址和两种密钥从同一个 Langfuse 项目的设置页获取；不是模型 API Key。
TRAVEL_LANGFUSE_ENABLED=0
TRAVEL_LANGFUSE_CAPTURE_CONTENT=0
TRAVEL_LANGFUSE_CONTENT_MAX_CHARS=131072
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 单独生成的随机值（至少32字符），用于身份/会话/请求 HMAC 匿名化，不是平台密钥。
TRAVEL_LANGFUSE_HASH_KEY=
# 默认查询服务，不会自动回退到 FlyAI。
TRAVEL_PROVIDER=tuniu
# 使用普通途牛 API Key；OAuth 模式请显式改为 oauth。
TUNIU_AUTH_TYPE=apiKey
TUNIU_API_KEY=
# OAuth Access Token，不是飞猪/途牛 API Key，也不是 OAuth 客户端密钥。
# 仅当授权资源覆盖三个服务时，才可使用共用 Token。
TUNIU_ACCESS_TOKEN=
# 各资源专用 Token 优先于共用 Token。
TUNIU_FLIGHT_ACCESS_TOKEN=
TUNIU_TRAIN_ACCESS_TOKEN=
TUNIU_HOTEL_ACCESS_TOKEN=
# 留空时按模式选择官方地址；不要混用 /mcp 与 /hybrid/mcp。
TUNIU_FLIGHT_MCP_URL=
TUNIU_TRAIN_MCP_URL=
TUNIU_HOTEL_MCP_URL=
# 搜索后只读补充详情：0关闭；最多补充前N家，不代表比较了全部酒店/房型。
TUNIU_HOTEL_DETAIL_LIMIT=3
# 每家最多保留N个房型报价；优先保留返回有库存的报价。
TUNIU_HOTEL_RATE_LIMIT=4
# 单家详情超时；搜索完成后整个详情阶段的额外总时限（秒）。
TUNIU_HOTEL_DETAIL_TIMEOUT=12
TUNIU_HOTEL_DETAIL_BUDGET=25
# 以下路径仅在 TRAVEL_PROVIDER=flyai 时使用。
FLYAI_NODE_PATH=
FLYAI_CLI_PATH=
# 确认供应商的币种含义之前，请保持为空。
FLYAI_PRICE_CURRENCY=
AMAP_API_KEY=
TRAVEL_POLICY_RULES_PATH=
TRAVEL_POLICY_DOCS_DIR=
# 政策后端：local 保留本地文本模式；填写以下配置后显式改为 pgvector。
TRAVEL_POLICY_BACKEND=local
# PostgreSQL 连接串，用户名/密码中的特殊字符须 URL 编码；生产环境启用 TLS。
TRAVEL_POLICY_DATABASE_URL=
# 当前部署绑定的公司标识，不接受模型传入其他公司。
TRAVEL_POLICY_COMPANY_ID=
TRAVEL_POLICY_KEY=travel
# 推荐政策引用：fragments 精确片段（默认）；grouped 保留旧整组展示用于对比。
TRAVEL_POLICY_CITATION_MODE=fragments
# estimate: deterministic amount estimates; legacy: original single-expense checks.
TRAVEL_POLICY_CHECK_MODE=estimate
TRAVEL_REIMBURSEMENT_MAX_NIGHTS=366
# 长期偏好、历史行程、对话检查点统一使用 PostgreSQL，不自动退回 SQLite。
# 留空时复用上方 TRAVEL_POLICY_DATABASE_URL，不需要重复填写密码。
TRAVEL_MEMORY_DATABASE_URL=
# 留空时复用 TRAVEL_POLICY_COMPANY_ID；同一部署的记忆与政策必须属于同一公司。
TRAVEL_MEMORY_COMPANY_ID=
# 独立 schema，不能使用 public 或 pg_ 开头的系统 schema。
TRAVEL_MEMORY_SCHEMA=travel_memory
TRAVEL_MEMORY_CONNECT_TIMEOUT=10
# 每次查询最多展示的近期行程数量，不限制数据库实际保存数量。
TRAVEL_MEMORY_HISTORY_LIMIT=10
# 多人执行限制：默认开启；同数据库、同memory schema的进程共享槽位和配额。
TRAVEL_RESOURCE_USER_CONCURRENCY=1
# 单校部署只保留一个系统级执行容量，不再重复维护学校/全局两层并发。
TRAVEL_RESOURCE_GLOBAL_CONCURRENCY=8
# 有界等待，不承诺严格FIFO；同用户超过并发直接拒绝。
TRAVEL_RESOURCE_QUEUE_SIZE=8
TRAVEL_RESOURCE_QUEUE_TIMEOUT=2
TRAVEL_RESOURCE_POLL_SECONDS=0.05
# UTC日界线；每次请求预留REQUEST_CALLS，正常退出退回未用调用，进程崩溃保守保留。
TRAVEL_RESOURCE_USER_DAILY_REQUESTS=100
TRAVEL_RESOURCE_COMPANY_DAILY_REQUESTS=1000
TRAVEL_RESOURCE_USER_DAILY_CALLS=2000
TRAVEL_RESOURCE_COMPANY_DAILY_CALLS=20000
TRAVEL_RESOURCE_REQUEST_CALLS=24
# 单进程每个数据库/池的连接数；长执行池与短查询池分开。
TRAVEL_DB_POOL_SIZE=12
# 至少 2*(GLOBAL_CONCURRENCY+QUEUE_SIZE)+2，留出历史读取空间。
TRAVEL_DB_SESSION_POOL_SIZE=36
TRAVEL_DB_POOL_WAITING=16
TRAVEL_DB_POOL_TIMEOUT=5
# 兼容 /embeddings 的 HTTPS 基础地址（通常以 /v1 结尾），不是聊天模型接口路径。
TRAVEL_EMBEDDING_BASE_URL=
TRAVEL_EMBEDDING_API_KEY=
TRAVEL_EMBEDDING_MODEL=
# 必须填写模型实际输出维度，程序验证响应，不强行请求供应商降维。
TRAVEL_EMBEDDING_DIMENSIONS=
TRAVEL_EMBEDDING_REVISION=1
# 单次向量请求条数；默认单条，确认供应商批量限制后再调大（程序范围1至64）。
TRAVEL_EMBEDDING_BATCH_SIZE=1
# pgvector HNSW 参数；维度来自上方 Embedding 配置，初始化/迁移时创建对应索引。
TRAVEL_POLICY_HNSW_M=16
TRAVEL_POLICY_HNSW_EF_CONSTRUCTION=128
TRAVEL_POLICY_HNSW_EF_SEARCH=80
TRAVEL_POLICY_TOP_K=5
TRAVEL_POLICY_RECALL_K=20
TRAVEL_POLICY_RRF_K=60
# qwen: API重排（缺配置/超时自动退回RRF）；rrf: 原有排序实验基线。
TRAVEL_POLICY_RERANK_MODE=qwen
# 使用控制台示例的原生 API 地址；也支持北京统一地址 https://dashscope.aliyuncs.com/api/v1。
TRAVEL_RERANK_BASE_URL=https://maas.qianwenaiapi.com/api/v1
TRAVEL_RERANK_API_KEY=
# 如需使用控制台示例模型，可改为 qwen3.7-text-rerank。
TRAVEL_RERANK_MODEL=qwen3-rerank
TRAVEL_RERANK_TIMEOUT=8
TRAVEL_RERANK_CANDIDATES=40
TRAVEL_POLICY_CONTEXT_LIMIT=40
# 发送给解释模型的来源 JSON 字符预算；超限不会静默裁掉必要条款。
TRAVEL_POLICY_CONTEXT_CHARS=24000
# 包含首次检索的总次数，1 表示禁用补检索，范围1至3；不会更换公司或适用日期。
TRAVEL_POLICY_RAG_MAX_RETRIEVALS=2
# 每次检索证据下的回答尝试上限，1-3；不重试供应商故障。
TRAVEL_POLICY_RAG_MAX_ANSWER_ATTEMPTS=2
# 可选 jieba 词典路径；更改分词词典需重新导入新版本。
TRAVEL_POLICY_DICTIONARY_PATH=
TRAVEL_TIMEOUT_SECONDS=45
TRAVEL_MAX_STEPS=30
TRAVEL_MAX_CANDIDATES=10

# 同源 Web 登录：本地默认可直接使用；生产部署必须改成 HTTPS，不带末尾斜杠。
# 若修改监听端口，必须同步修改此 Origin。
TRAVEL_WEB_ORIGIN=http://127.0.0.1:8000
# 登录会话绝对有效期（秒），无自动续期。
TRAVEL_AUTH_SESSION_SECONDS=28800
# 单个直连客户端 IP 在窗口内最多允许的登录尝试次数，存储于 PostgreSQL。
TRAVEL_AUTH_RATE_SECONDS=300
TRAVEL_AUTH_RATE_LIMIT=30
# 同一账号连续失败后的临时锁定。
TRAVEL_AUTH_MAX_FAILURES=10
TRAVEL_AUTH_LOCK_SECONDS=900
